<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Watch-local App Group container -- see CobuxWatch.entitlements' comment. Same name as the
  iOS-side group, does not share data with it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.rajansharma.Cobux</string>
	</array>
</dict>
</plist>
